[Unit]
Description=Run MPV player shows door eye
After=network.target

[Service]
EnvironmentFile=/etc/door-eye/app.env
EnvironmentFile=/etc/door-eye/mpv.env
EnvironmentFile=/etc/door-eye/screen.env
ExecStart=/usr/local/bin/show-door-eye
RuntimeMaxSec=1d
RestartSec=5
Restart=always

[Install]
WantedBy=multi-user.target
