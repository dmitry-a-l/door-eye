BT_DEVICE_MAC="00:11:22:33:44:55"

# Readiness poll interval while the sink is present, sec
BT_RECONNECT_INTERVAL=20
# Pause between reconnect attempts while the sink is down, sec
BT_RETRY_INTERVAL=3
# Timeout of a single bluetoothctl connect attempt, sec
BT_CONNECT_TIMEOUT=12
# How long to wait for the A2DP sink to appear after a connect, sec
BT_SINK_WAIT=8
# Plain connect attempts before falling back to an adapter power-cycle
BT_GENTLE_ATTEMPTS=3
# Seconds to wait after a power-cycle for WirePlumber to re-register A2DP
BT_A2DP_SETTLE=5

BT_VOLUME=0.6
XDG_RUNTIME_DIR=/run/pipewire
