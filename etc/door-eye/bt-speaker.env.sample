BT_DEVICE_MAC="00:11:22:33:44:55"

# Период проверки готовности, когда sink на месте, сек
BT_RECONNECT_INTERVAL=20
# Пауза между попытками реконнекта, пока sink не поднят, сек
BT_RETRY_INTERVAL=3
# Таймаут одной попытки bluetoothctl connect, сек
BT_CONNECT_TIMEOUT=12
# Сколько ждать появления A2DP-sink после power-cycle, сек
BT_SINK_WAIT=8

BT_VOLUME=0.6
XDG_RUNTIME_DIR=/run/pipewire
