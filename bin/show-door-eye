#!/usr/bin/env bash
set -Eeuo pipefail

mkdir -p ${SOCK_PATH%/*}

/usr/bin/mpv --quiet \
             --no-config \
             --cache=no \
             --hr-seek=no \
             --profile=low-latency  \
             --stream-buffer-size=4KiB \
             --vf=crop="${VIDEO_CROP_PARAMS}" \
             --osd-duration=10000 \
             --osd-align-x=center \
             --osd-margin-y=50 \
             --osd-font-size="${OSD_FONT_SIZE}" \
             --input-ipc-server="${SOCK_PATH}" \
             --hwdec=v4l2m2m-copy \
             --hwdec-codecs=h264 \
             --swapchain-depth=8 \
             --sws-fast=yes \
             --drm-device="${DRM_NODE}" \
             --drm-connector=${HDMI_CONNECTOR} \
             --drm-mode=${SCREEN_RESOLUTION} \
             ${STREAM_URL} "${@}"
