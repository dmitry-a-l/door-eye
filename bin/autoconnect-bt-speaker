#!/usr/bin/env bash

set -Eeuo pipefail

MAC_UNDERSCORE="${BT_DEVICE_MAC//:/_}"

log() {
  echo "$*" >&2
}

# Готовность определяем по наличию A2DP-sink в PipeWire, а НЕ по флагу
# Connected в BlueZ: после самозасыпания колонки BlueZ может держать
# фантомный Connected=yes без живого транспорта.
sink_ready() {
  pw-cli ls Node 2>/dev/null | grep -q "bluez_output.${MAC_UNDERSCORE}"
}

wait_sink() {
  local wait_sec="${1}"
  local deadline=$(( EPOCHSECONDS + wait_sec ))
  while (( EPOCHSECONDS < deadline )); do
    sink_ready && return 0
    sleep 0.5
  done
  return 1
}

connect_speaker() {
  timeout "$BT_CONNECT_TIMEOUT" \
    bluetoothctl connect "$BT_DEVICE_MAC" >/dev/null 2>&1
}

# Сброс фантомного линка: обычный disconnect на мёртвом линке висит,
# поэтому передёргиваем питание контроллера — это гарантированно чистит
# зависшее состояние, после чего connect поднимает транспорт заново.
recover_link() {
  log "Recovering link via adapter power-cycle. Powering off"
  bluetoothctl power off
  sleep 2
  log "Recovering link via adapter power-cycle. Powering on"
  bluetoothctl power on
  sleep 2
}

reconnect() {
  log "Sink missing, reconnecting"
  if connect_speaker; then
    wait_sink 5 
    log "Reconnected"
  else
    log "Still no sink — likely phantom, recovering"
    recover_link
    connect_speaker
    wait_sink "$BT_SINK_WAIT"
    log "Reconnected after recovery"
  fi
}

log "Started autoconnect-bt-speaker for $BT_DEVICE_MAC"

while true; do
  if sink_ready; then
    sleep "$BT_RECONNECT_INTERVAL"
    continue
  fi
  if ! reconnect; then
    sleep "$BT_RETRY_INTERVAL"
  fi
done
