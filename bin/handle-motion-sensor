#!/bin/bash

POLL_INTERVAL=1
HDMI_CONNECT_TIMEOUT=10              # макс. сек на ожидание первого connected
HDMI_STABLE_DURATION=3               # сек подряд connected, чтобы считать стабильным
HDMI_STABLE_POLL=0.1                 # период опроса при мониторинге стабильности
HDMI_DISCONNECT_SETTLE=0.3
DRM_WAIT_TIMEOUT=3
TURN_ON_MAX_ATTEMPTS=3

log() {
    echo "$1" >&2
}

set_connector() {
    local mode="${1}"
    log "Setting connector ${mode}"
    echo "${mode}" > "${HDMI_CTL_PATH}"
}

is_hdmi_connected() {
    [[ "$(cat "${HDMI_CTL_PATH}")" == "connected" ]]
}

wait_hdmi_connected() {
    local deadline=$(( EPOCHSECONDS + HDMI_CONNECT_TIMEOUT ))
    while [[ ${EPOCHSECONDS} -lt ${deadline} ]]; do
        if is_hdmi_connected; then
            return 0
        fi
        sleep 0.1
    done
    log "ERROR: connector did not become connected within ${HDMI_CONNECT_TIMEOUT}s"
    return 1
}

# Ждём, пока статус останется connected непрерывно ${HDMI_STABLE_DURATION} секунд.
# Если в течение этого времени словили disconnected — пишем в лог и отсчёт стабильности сбрасывается.
# Общий бюджет времени: HDMI_CONNECT_TIMEOUT (на случай долгих флапов).
wait_hdmi_stable() {
    local needed_polls
    needed_polls=$(awk "BEGIN { print int(${HDMI_STABLE_DURATION} / ${HDMI_STABLE_POLL}) }")
    local streak=0
    local flap_count=0
    local deadline=$(( EPOCHSECONDS + HDMI_CONNECT_TIMEOUT ))

    while [[ ${EPOCHSECONDS} -lt ${deadline} ]]; do
        if is_hdmi_connected; then
            streak=$(( streak + 1 ))
            if [[ ${streak} -ge ${needed_polls} ]]; then
                if [[ ${flap_count} -gt 0 ]]; then
                    log "Connector stabilised after ${flap_count} flap(s)"
                fi
                return 0
            fi
        else
            if [[ ${streak} -gt 0 ]]; then
                flap_count=$(( flap_count + 1 ))
                log "Connector flapped to disconnected (flap #${flap_count}, streak was ${streak})"
            fi
            streak=0
        fi
        sleep "${HDMI_STABLE_POLL}"
    done

    log "ERROR: connector did not stay stable for ${HDMI_STABLE_DURATION}s within ${HDMI_CONNECT_TIMEOUT}s"
    return 1
}

wait_drm_presented() {
    local deadline=$(( EPOCHSECONDS + DRM_WAIT_TIMEOUT ))
    while [[ ${EPOCHSECONDS} -lt ${deadline} ]]; do
        if [[ -e "${DRM_NODE}" ]]; then
            return 0
        fi
        sleep 0.1
    done
    log "ERROR: ${DRM_NODE} did not appear within ${DRM_WAIT_TIMEOUT}s"
    return 1
}

turn_screen_on() {
    local attempt
    for (( attempt = 1; attempt <= TURN_ON_MAX_ATTEMPTS; attempt++ )); do
        set_connector on
        if wait_hdmi_connected && wait_drm_presented && wait_hdmi_stable; then
            screen_on=1
            return 0
        fi
        log "turn_screen_on attempt ${attempt} failed, retrying"
        set_connector off
        sleep 1
    done
    log "ERROR: turn_screen_on gave up after ${TURN_ON_MAX_ATTEMPTS} attempts"
    return 1
}

turn_screen_off() {
    sleep "${HDMI_DISCONNECT_SETTLE}"
    set_connector off
    TERM=linux clear > /dev/tty1
    screen_on=0
}

handle_motion_detected() {
    log "Motion detected"
    if ! turn_screen_on; then
        return
    fi
    systemctl start show-door-eye
    systemctl restart update-door-eye-osd
}

handle_motion_cleared() {
    log "Motion cleared"
    TERM=linux clear > /dev/tty1
    systemctl stop show-door-eye
    turn_screen_off
}

MOTION_CLEAR_THRESHOLD=5

log "Started"

if is_hdmi_connected; then
    screen_on=1
else
    screen_on=0
fi

clear_count=0

while true; do
    if pin100=$(/usr/local/bin/rp-cmd "GET 100" 2>/dev/null); then
        if [[ "${pin100}" == "1" ]]; then
            clear_count=0
            if [[ "${screen_on}" != "1" ]]; then
                handle_motion_detected
            fi
        elif [[ "${pin100}" == "0" ]]; then
            clear_count=$(( clear_count + 1 ))
            if [[ "${screen_on}" != "0" && "${clear_count}" -ge "${MOTION_CLEAR_THRESHOLD}" ]]; then
                handle_motion_cleared
            fi
        fi
    else
        log "Skipping unexpected rp-cmd output: ${pin100}"
    fi
    sleep "${POLL_INTERVAL}"
done
