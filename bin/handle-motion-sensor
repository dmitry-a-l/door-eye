#!/bin/bash
set -eu

POLL_INTERVAL=0.2
TURN_ON_FAIL_RETRY=1
MOTION_CLEAR_THRESHOLD=3
HDMI_CONNECT_TIMEOUT=10
HDMI_DISCONNECT_SETTLE=0.3
DRM_WAIT_TIMEOUT=3

log() {
    echo "$1" >&2
}

set_connector() {
    local mode="${1}"
    log "Setting connector ${mode}"
    echo "${mode}" > "${HDMI_CTL_PATH}"
}

is_hdmi_connected() {
    [[ "$(cat "${HDMI_CTL_PATH}")" == "connected" ]]
}

wait_hdmi_connected() {
    local deadline=$(( EPOCHSECONDS + HDMI_CONNECT_TIMEOUT ))
    while [[ ${EPOCHSECONDS} -lt ${deadline} ]]; do
        if is_hdmi_connected; then
            return 0
        fi
        sleep 0.1
    done
    log "ERROR: connector did not become connected within ${HDMI_CONNECT_TIMEOUT}s"
    return 1
}


wait_drm_presented() {
    local deadline=$(( EPOCHSECONDS + DRM_WAIT_TIMEOUT ))
    while [[ ${EPOCHSECONDS} -lt ${deadline} ]]; do
        if [[ -e "${DRM_NODE}" ]]; then
            return 0
        fi
        sleep 0.1
    done
    log "ERROR: ${DRM_NODE} did not appear within ${DRM_WAIT_TIMEOUT}s"
    return 1
}

clear_screen() {
    TERM=linux clear > /dev/tty1
}

turn_screen_on() {
    set_connector on
    clear_screen
    wait_hdmi_connected
    wait_drm_presented
}

turn_screen_off() {
    sleep "${HDMI_DISCONNECT_SETTLE}"
    set_connector off
    clear_screen
}

handle_motion_detected() {
    log "Motion detected"
    turn_screen_on
    systemctl start show-door-eye
    systemctl restart update-door-eye-osd
}

handle_motion_cleared() {
    log "Motion cleared"
    clear_screen
    systemctl stop show-door-eye
    turn_screen_off
}

log "Started"

handle_motion_cleared

motion_active=0
clear_count=0

while true; do
    if secs=$(/usr/local/bin/rp-cmd "GET 100"); then
        if (( secs > 0 )); then
            clear_count=0
            if (( motion_active == 0 )); then
                secs="$(( secs + 1 ))"
                if ! handle_motion_detected; then
                    log "Motion detected but screen failed to turn on, retrying next cycle"
                    sleep "${TURN_ON_FAIL_RETRY}"
                    continue
                fi
                motion_active=1
            fi
            log "Waiting ${secs}s to next motion check"
            sleep "${secs}"
        else
            clear_count=$(( clear_count + 1 ))
            if (( motion_active == 1 && clear_count >= MOTION_CLEAR_THRESHOLD )); then
                handle_motion_cleared
                motion_active=0
            fi
            sleep "${POLL_INTERVAL}"
        fi
    else
        log "Skipping unexpected rp-cmd output: ${secs}"
        sleep "${POLL_INTERVAL}"
    fi
done
