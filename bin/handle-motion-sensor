#!/bin/bash

POLL_INTERVAL=1
HDMI_CONNECT_TIMEOUT=3       # макс. сек на ожидание connected после echo on
HDMI_DISCONNECT_SETTLE=5     # доп. пауза после connected, чтобы modeset устаканился
DRM_WAIT_TIMEOUT=3           # макс. сек на ожидание появления DRM устройства
DRM_APPEARING_SETTLE=1       # доп. пауза после появления drm

log() {
    echo "$1" >&2
}

set_connector() {
    local mode="${1}"
    log "Setting connector ${mode}"
    echo "${mode}" > "${HDMI_CTL_PATH}"
}

is_hdmi_connected() {
    [[ "$(cat "${HDMI_CTL_PATH}")" == "connected" ]]
}

wait_hdmi_connected() {
    local deadline=$(( EPOCHSECONDS + HDMI_CONNECT_TIMEOUT ))
    while [[ ${EPOCHSECONDS} -lt ${deadline} ]]; do
        if is_hdmi_connected; then
            return 0
        fi
        sleep 0.1
    done
    log "ERROR: connector did not become connected within ${HDMI_CONNECT_TIMEOUT}s"
    exit 1
}

wait_drm_presented() {
    local deadline=$(( EPOCHSECONDS + DRM_WAIT_TIMEOUT ))
    while [[ ${EPOCHSECONDS} -lt ${deadline} ]]; do
        if [[ -e "${DRM_NODE}" ]]; then
            return 0
        fi
        sleep 0.1
    done

    log "ERROR: ${DRM_NODE} did not appear within ${DRM_WAIT_TIMEOUT}s"
    exit 1
}


turn_screen_on() {
    set_connector on
    wait_hdmi_connected
    wait_drm_presented
    sleep "${DRM_APPEARING_SETTLE}"
    screen_on=1
}

turn_screen_off() {
    set_connector off
    TERM=linux clear > /dev/tty1
    sleep "${HDMI_DISCONNECT_SETTLE}"
    # дать mpv действительно закрыть DRM до того, как мы отключим коннектор
    screen_on=0
}

handle_motion_detected() {
    log "Motion detected"
    turn_screen_on
    systemctl start show-door-eye
    systemctl restart update-door-eye-osd
}

handle_motion_cleared() {
    log "Motion cleared"
    TERM=linux clear > /dev/tty1
    systemctl stop show-door-eye
    turn_screen_off
}

log "Started"

if is_hdmi_connected; then
  screen_on=1
else
  screen_on=0
fi

while true; do
    if pin100=$(/usr/local/bin/rp-cmd "GET 100" 2>/dev/null); then
        if [[ "${pin100}" == "1" && "${screen_on}" != "1" ]]; then
            handle_motion_detected
        elif [[ "${pin100}" == "0" && "${screen_on}" != "0" ]]; then
            handle_motion_cleared
        fi
    else
        log "Skipping unexpected rp-cmd output: ${pin100}"
    fi

    sleep "${POLL_INTERVAL}"
done
