#!/bin/bash

source /etc/door-eye/rp.env

HDMI_CTL_PATH="/sys/class/drm/card1-HDMI-A-1/status"
POLL_INTERVAL=0.5
vpin100_active=1

log() {
    echo "$1" >&2
}

turn_screen() {
  local mode="${1}"
  log "Turninig screen $mode"
  echo "$mode" > "$HDMI_CTL_PATH"
}

log "Started"


while true; do
    val=$(/usr/local/bin/rp-cmd "GET 100")

    if [[ $? != 0 ]]; then
        log "ERR - rp-cmd failed. Error code: $?"
        sleep "$POLL_INTERVAL"
        continue
    fi

    if [[ "$val" == "1" && "$vpin100_active" == "0" ]]; then
        log "Motion detected - starting show-door-eye"
        turn_screen on
        systemctl start show-door-eye
        systemctl restart update-door-eye-osd
        vpin100_active=1
    elif [[ "$val" == "0" && "$vpin100_active" == "1" ]]; then
        log "Motion cleared - stopping show-door-eye"
        turn_screen off
        systemctl stop show-door-eye
        vpin100_active=0
    fi

    sleep "$POLL_INTERVAL"
done
