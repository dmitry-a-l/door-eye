#!/usr/bin/env bash

set -eEuo pipefail

MAX_ITERATIONS=20
ACTION_TIME=0.1

declare -A OUTPUT_PINS
OUTPUT_PINS=(
  [open_lock]=PIN_31
  [close_lock]=PIN_29
  [lock_led]=PIN_35
)

declare -A OUTPUT_PORTS
for output in "${!OUTPUT_PINS[@]}"; do
  pin="${OUTPUT_PINS[$output]}"
  OUTPUT_PORTS[$output]="$(gpiofind $pin)"
done

INPUT_PINS=(
  door_closed
  lock_closed
  lock_opened
  extra1
  extra2
)

declare -A INPUTS
INPUTS=(
  [door_closed]=58
  [lock_closed]=56
  [lock_opened]=28
  [extra1]=55
  [extra2]=51
)

DOOR_CLOSED_TIME=""
AUTOCLOSE_PERIOD="10"

CHIP=gpiochip4

ACTION="${1}"

log() {
  echo "${@}" >&2
}

set_output_high() {
  local name="${1}"
  local address="${OUTPUT_PORTS[$name]}"
  gpioset ${address}=1
}

set_output_low() {
  local name="${1}"
  gpioset ${OUTPUT_PORTS[$name]}=0
}

get_input() {
  local name="${1}"
  gpioget "${CHIP}" "${INPUTS[$name]}"
}

get_output() {
  local name="${1}"
  cat /sys/kernel/debug/gpio | tail -n188 | head -n 96 | grep "gpio${OUTPUTS[$name]} "
}

is_door_closed() {
  local door_closed=""
  door_closed="$(get_input door_closed)"
  [[ "${door_closed}" == "1" ]]
}

is_lock_closed() {
  local lock_closed=""
  lock_closed="$(get_input lock_closed)"
  [[ "${lock_closed}" == "1" ]]
}

is_lock_half_closed() {
  ! is_lock_closed && ! is_lock_opened
}

is_lock_opened() {
  local lock_opened=""
  lock_opened="$(get_input lock_opened)"
  [[ "${lock_opened}" == "1" ]]
}

init() {
  for name in "${OUTPUT_PINS[@]}"; do
    set_output_low "${name}"
  done

  set_output_high "lock_led"
  set_output_high "extra_led"
}


print_state() {
  echo '======='
  for name in "${INPUT_PINS[@]}"; do
    echo "${name}: $(get_input "${name}")" 
  done
  echo '======='
  for name in "${OUTPUT_PINS[@]}"; do
    echo "${name}: $(get_output "${name}")"
  done
}

close_lock() {
  local i=0
  log "Closing lock"
  #while is_door_closed && ! is_lock_closed; do
    set_output_high "close_lock"
    sleep ${ACTION_TIME}
    set_output_low "close_lock"
  #  i="$((i+1))"
  #  if [[ "${i}" -gt "${MAX_ITERATIONS}" ]]; then
  #    break
  #  fi
  #done
}

highlight_lock() {
  log "Highlighting lock"
  #while is_door_closed && ! is_lock_closed; do
  for ((i=0; i<10; i++)); do
    set_output_high "lock_led"
    sleep ${ACTION_TIME}
    sleep 1
    set_output_low "lock_led"
    sleep 0.5
  done
  #  i="$((i+1))"
  #  if [[ "${i}" -gt "${MAX_ITERATIONS}" ]]; then
  #    break
  #  fi
  #done
}

open_lock() {
  local i=0
  log "Opening lock"
  #while is_door_closed && ! is_lock_opened; do
    set_output_high "open_lock"
    sleep ${ACTION_TIME}
    set_output_low "open_lock"
  #  i="$((i+1))"
  #  if [[ "${i}" -gt "${MAX_ITERATIONS}" ]]; then
  #    break
  #  fi
  #done
}

set_door_closed_time() {
  if ! is_door_closed || ! is_lock_opened; then
    DOOR_CLOSED_TIME=""
  else
    if is_door_closed && is_lock_opened && [[ "${DOOR_CLOSED_TIME}" == "" ]]; then
      DOOR_CLOSED_TIME="${EPOCHSECONDS}"
    fi
  fi
}

need_autoclose_lock() {
  set_door_closed_time
  [[ "${DOOR_CLOSED_TIME}" != "" ]] && ((EPOCHSECONDS - DOOR_CLOSED_TIME > AUTOCLOSE_PERIOD))
}

auto_close_lock() {
  for ((;;)); do
    if need_autoclose_lock; then
      close_lock
    fi
    sleep 1 
  done
}

case "${ACTION}" in
  init)
    init
    ;;
  print_state|print-state)
    print_state
    ;;
  highlight_lock|highlight-lock)
    highlight_lock
    ;;
  close_lock|close-lock)
    close_lock
    ;;
  open_lock|open-lock)
    open_lock
    ;;
  auto_close_lock|auto-close-lock)
    init
    auto_close_lock
    ;;
esac
