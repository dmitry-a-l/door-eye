#!/usr/bin/env bash

set -Eeuo pipefail

source /etc/door-eye/door-station.env

POLL_INTERVAL=0.2
EVENT_WINDOW=5
COOLDOWN_INTERVAL=10

log() {
  echo "$*" >&2
}

query_events() {
  local start end
  start="$(date -u -d "${EVENT_WINDOW} seconds ago" '+%Y-%m-%dT%H:%M:%SZ')"

  curl -s --digest -u "${HIK_USER}:${HIK_PASSWORD}" \
    -X POST \
    -H "Content-Type: application/json" \
    -d "{\"AcsEventCond\":{\"searchID\":\"1\",\"searchResultPosition\":0,\"maxResults\":10,\"major\":5,\"minor\":0,\"startTime\":\"${start}\"}}" \
    "http://${HIK_HOST}/ISAPI/AccessControl/AcsEvent?format=json"
}

handle_authorized_card() {
  local event="${1}"
  local name card
  name="$(echo "${event}" | jq -r '.name // "unknown"')"
  card="$(echo "${event}" | jq -r '.cardNo // "unknown"')"
  log "ACCESS GRANTED | ${name} | card: ${card}"
}

handle_unauthorized_card() {
  local event="${1}"
  local card
  card="$(echo "${event}" | jq -r '.cardNo // "unknown"')"
  log "ACCESS DENIED | unauthorized card: ${card}"
}

handle_indoor_button() {
  log "DOOR OPENED | from indoor intercom"
}

unlock() {
  log "Sending UNLOCK command"
  /usr/local/bin/rp-cmd "UNLOCK" || log "ERR failed to send UNLOCK"
  sleep "${COOLDOWN_INTERVAL}"
}

log "Started"

while true; do
  response="$(query_events)"
  if [[ $? != 0 ]]; then
    log "ERR curl failed"
    sleep "${POLL_INTERVAL}"
    continue
  fi

  matches="$(jq -r '.AcsEvent.numOfMatches // 0' <<< "${response}")"

  need_open_door=0

  if [[ "${matches}" -gt 0 ]]; then
    log "Handling ${matches} events"

    while IFS= read -r event; do
      minor="$(jq -r '.minor' <<< "${event}")"

      case "${minor}" in
        1)
          handle_authorized_card "${event}"
          need_open_door=1
          ;;
        9)
          handle_unauthorized_card "${event}"
          ;;
        158)
          handle_indoor_button
          need_open_door=1
          ;;
        21)
          log "Event 'door is opened (door lock)'"
          need_open_door=1
          ;;
        92)
          log "Door is unlocked in wrong state"
          need_open_door=1
          ;;
        216|214)
          log "Door is unlocked in wrong state by indoor button"
          need_open_door=1
          ;;
        22)
          log "Event 'door is closed (door lock)'"
          ;;
        26)
          log "Event 'door is normally closed'"
          ;;
        *)
          log "Unknown event code: ${minor}"
          ;;
      esac
    done < <(echo "${response}" | jq -c '.AcsEvent.InfoList[]')
  fi

  if [[ "${need_open_door}" -eq 1 ]]; then
    unlock
  else
    sleep "${POLL_INTERVAL}"
  fi
done
